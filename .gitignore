# Large simulation outputs. Keep the run JSONs, compact theory arrays and plots.
*_trajectory.npy
*_neuron_statistics.npz
/experiments/readout_pilot/measurements/*_blocks.npz
/experiments/readout_confirmation/records/
/experiments/analytics/local_block_capsules/*.npz

# Local links left at the paths used by the original handoff
/final/

